# 数据库配置
# 格式: mysql+aiomysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
DATABASE_URL=mysql+aiomysql://root:lyp82ndlf@localhost:3307/news_app?charset=utf8mb4

# JWT密钥 (生产环境请修改为随机字符串)
SECRET_KEY=your-super-secret-key-change-this-in-production

# CORS跨域配置
# 多个域名用逗号分隔，如: https://frontend.vercel.app,https://example.com
# 使用 * 表示允许所有来源（开发环境）
CORS_ORIGINS=*

# 服务器配置
HOST=0.0.0.0
PORT=8000
